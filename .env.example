# ─────────────────────────────────────────────────────────────────────────────
# Ophelia storefront — environment contract
#
# Copy to `.env.local` for development, and set the same keys in the Vercel
# project settings for preview/production. NEVER commit a filled-in file.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle. Every
# other variable below is server-only and must never gain that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Drives canonical URLs, Open Graph,
# sitemap.xml and robots.txt. Required in production.
NEXT_PUBLIC_SITE_URL="https://www.callmeophelia.com"


# ── Shopify Storefront API (required for real products, cart and checkout) ───
# Store domain in *.myshopify.com form — not the custom domain.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# Storefront API access token from a custom app (Admin → Settings → Apps and
# sales channels → Develop apps → Storefront API). Public scope, but it is read
# here on the server only; do not expose it to the browser.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Storefront API version, YYYY-MM. Bump deliberately, then re-run `npm run build`.
SHOPIFY_STOREFRONT_API_VERSION="2025-07"


# ── Shopify Customer Account API (optional — powers /conta) ──────────────────
# Leave blank to ship without customer accounts: /conta then renders a
# documented "not configured" state instead of a fake sign-in.
# Values come from Admin → Settings → Customer accounts → (new customer
# accounts) → Customer Account API credentials.
SHOPIFY_CUSTOMER_ACCOUNT_API_URL=""
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=""
# Must exactly match a redirect URI registered in Shopify:
#   https://<your-domain>/conta/callback
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=""


# ── Enquiry delivery (Eventos + Personalizadas forms) ───────────────────────
# A webhook that receives the enquiry payload as JSON POST (Zapier, Make,
# Resend proxy, a Shopify Flow trigger, your own endpoint). When unset, the
# forms return an honest 503 and tell the visitor to email us instead — they
# never show a fake success.
OPHELIA_ENQUIRY_WEBHOOK_URL=""
# Optional signing key. When set, the payload is signed and sent as
# `X-Ophelia-Signature: sha256=<hex hmac>` so the receiver can verify it.
OPHELIA_ENQUIRY_WEBHOOK_SECRET=""


# ── Cache revalidation ───────────────────────────────────────────────────────
# Shopify's webhook signing secret. POST /api/revalidate verifies Shopify's
# `X-Shopify-Hmac-Sha256` signature against it, so product and collection
# changes appear without a redeploy. The same value also authorises a manual
# purge sent as `X-Ophelia-Revalidate-Secret`.
OPHELIA_REVALIDATION_SECRET=""


# ── Local catalogue (development only) ───────────────────────────────────────
# When SHOPIFY_STORE_DOMAIN / SHOPIFY_STOREFRONT_ACCESS_TOKEN are absent the app
# falls back to the typed local catalogue in lib/catalogue/, built from the
# client's own product documents. It mirrors the Shopify data shapes exactly so
# the UI is identical, but it is NOT Shopify: checkout is disabled and a banner
# says so. Set this to "true" to force it even when credentials exist.
OPHELIA_FORCE_LOCAL_CATALOGUE="false"
