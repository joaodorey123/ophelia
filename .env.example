# ─────────────────────────────────────────────────────────────────────────────
# Ophelia storefront — environment contract
#
# Copy to `.env.local` for development, and set the same keys in the Vercel
# project settings for preview and production. NEVER commit a filled-in file:
# `.env.local` is gitignored and must stay that way.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle. Every
# other variable below is server-only and must never gain that prefix.
#
# After filling this in, run `npm run shopify:doctor` — it checks the whole
# integration (token, API version, collections, publishing, cart) and never
# prints the token.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Drives canonical URLs, Open Graph,
# sitemap.xml and robots.txt. Required in production; falls back to the Vercel
# deployment URL on previews and to localhost in development.
NEXT_PUBLIC_SITE_URL="https://www.callmeophelia.com"


# ── Shopify Storefront API (required: products, cart and checkout) ───────────
# The *.myshopify.com domain, not the custom one.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# Tokens come from Shopify admin:
#   Settings > Apps and sales channels > Headless > Storefront API
#
# Set ONE of the two. Every request this app makes is server-side, so the
# PRIVATE token is preferred: higher rate limits, and it is never safe in a
# browser. When both are present the private one wins.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Storefront API version, YYYY-MM.
#
# Shopify does NOT reject an unsupported version — it silently serves an older
# one and mentions it only in a response header, which is how a storefront ends
# up running on year-old fields. `npm run shopify:doctor` checks the version
# actually served against this value. Bump deliberately, then rebuild.
SHOPIFY_STOREFRONT_API_VERSION="2026-07"


# ── Contact form delivery ────────────────────────────────────────────────────
# A webhook that receives the enquiry as a JSON POST (Zapier, Make, Resend
# proxy, Shopify Flow, your own endpoint). When unset, /api/enquiry answers 503
# and the contact form tells the visitor to email instead — it never shows a
# success message for a message nobody received.
OPHELIA_ENQUIRY_WEBHOOK_URL=""
# Optional signing key. When set, the payload is signed and sent as
# `X-Ophelia-Signature: sha256=<hex hmac>` so the receiver can verify it.
OPHELIA_ENQUIRY_WEBHOOK_SECRET=""


# ── Cache revalidation ───────────────────────────────────────────────────────
# Shopify's webhook signing secret. POST /api/revalidate verifies Shopify's
# `X-Shopify-Hmac-Sha256` header against it, so product and collection edits
# appear without a redeploy. The same value also authorises a manual purge sent
# as `X-Ophelia-Revalidate-Secret`.
OPHELIA_REVALIDATION_SECRET=""


# ── Development fixture (never production) ───────────────────────────────────
# Serves the typed fixture catalogue in lib/catalogue/ — the handoff's own 27
# products across five collections — so the design can be reviewed and the
# browser suite can run without Shopify credentials.
#
# It is NOT a fallback. Nothing falls back to it automatically: if Shopify is
# misconfigured, pages fail with a configuration error rather than quietly
# serving fixture data that looks like a working shop. It has no cart and no
# checkout, and it refuses to run on a production deployment.
OPHELIA_FORCE_LOCAL_CATALOGUE="false"
